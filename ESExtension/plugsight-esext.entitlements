<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  TEMPLATE (N12): entitlements for com.plugsight.esext. The
  endpoint-security.client entitlement is RESTRICTED: distribution signing
  requires Apple's grant (N0, a RELEASE gate — 07). Until granted, the
  extension runs only on the SIP-relaxed dev machine with amfi_get_out_of_my_way
  / systemextensionsctl developer mode (ESExtension/README.md).
-->
<plist version="1.0">
<dict>
    <key>com.apple.developer.endpoint-security.client</key>
    <true/>
</dict>
</plist>
