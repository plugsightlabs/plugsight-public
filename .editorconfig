# EditorConfig for Plugsight
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Swift sources use four-space indentation.
[*.swift]
indent_size = 4

# Trailing spaces can be significant in markdown (hard line breaks).
[*.md]
trim_trailing_whitespace = false

# Makefiles and shell here-docs that require real tabs.
[Makefile]
indent_style = tab
